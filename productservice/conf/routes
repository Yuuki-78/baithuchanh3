# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

# API Quản lý sản phẩm (Bài thực hành 3)
GET     /products           controllers.ProductController.getAll()
POST    /products                   controllers.ProductController.create(request: Request)
GET     /products/:id               controllers.ProductController.getById(id: Integer)
PUT     /products/:id               controllers.ProductController.update(id: Integer, request: Request)
DELETE  /products/:id               controllers.ProductController.delete(id: Integer)
